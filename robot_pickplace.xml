<!--
  UR5e (Universal Robots) + Robotiq 2F-85 parallel gripper + cube + tray (box).

  Scene goal: pick up the free-floating cube and drop it inside the open tray.
  Both cube and tray are randomized at episode reset (the cube via free-joint
  qpos, the tray via mocap_pos).

  Models sourced from MuJoCo Menagerie:
    https://github.com/google-deepmind/mujoco_menagerie
  UR5e + 2F-85 setup with a task-specific cube and tray.
-->
<mujoco model="ur5e_2f85_pickplace">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <!-- UR5e defaults -->
    <default class="ur5e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <!-- Joint-level PD gains intentionally weakened (2x) so that payload
           sag is visible at the end-effector, exposing the steady-state
           offset that the outer Cartesian I-term must cancel. -->
      <general gaintype="fixed" biastype="affine"
               ctrlrange="-6.2831 6.2831" gainprm="1000"
               biasprm="0 -1000 -200" forcerange="-150 150"/>
      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size1">
        <general gainprm="250" biasprm="0 -250 -50" forcerange="-28 28"/>
      </default>
      <default class="ur5e_vis">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="ur5e_col">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <!-- Robotiq 2F-85 defaults -->
    <default class="2f85">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>
      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.005" damping="0.1"
               solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="-0.872664 0.872664" armature="0.001"
               pos="0 -0.018 0.0065"
               solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001"
               stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="coupler">
        <joint range="-1.57 0" armature="0.001"
               solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="grip_vis">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="grip_col">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125"
                size="0.011 0.004 0.009375" friction="0.7"
                solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"
                rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375"
                size="0.011 0.004 0.009375" friction="0.6"
                solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"
                rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <!-- UR5e materials -->
    <material class="ur5e" name="black"     rgba="0.033 0.033 0.033 1"/>
    <material class="ur5e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur5e" name="linkgray"  rgba="0.82 0.82 0.82 1"/>
    <material class="ur5e" name="urblue"    rgba="0.49 0.678 0.8 1"/>

    <!-- Robotiq materials -->
    <material name="metal"      rgba="0.58 0.58 0.58 1"/>
    <material name="silicone"   rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gray"       rgba="0.4627 0.4627 0.4627 1"/>
    <material name="grip_black" rgba="0.149 0.149 0.149 1"/>

    <!-- UR5e meshes -->
    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>

    <!-- Robotiq 2F-85 meshes (class="2f85" enforces scale=0.001) -->
    <mesh class="2f85" file="base_mount.stl"/>
    <mesh class="2f85" file="base.stl"/>
    <mesh class="2f85" file="driver.stl"/>
    <mesh class="2f85" file="coupler.stl"/>
    <mesh class="2f85" file="follower.stl"/>
    <mesh class="2f85" file="pad.stl"/>
    <mesh class="2f85" file="silicone_pad.stl"/>
    <mesh class="2f85" file="spring_link.stl"/>
  </asset>

  <worldbody>
    <light pos="1 1 2" dir="-0.3 -0.3 -1" diffuse="1 1 1"/>
    <light pos="-1 -1 1.5" dir="0.3 0.3 -1" diffuse="0.4 0.4 0.5"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.82 0.82 0.82 1"/>

    <!-- ================= UR5e ARM ================= -->
    <body name="ur5e_base" childclass="ur5e">
      <inertial mass="4.0" pos="0 0 0"
                diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom mesh="base_0" material="black" class="ur5e_vis"/>
      <geom mesh="base_1" material="jointgray" class="ur5e_vis"/>

      <body name="shoulder_link" pos="0 0 0.163">
        <inertial mass="3.7" pos="0 0 0"
                  diaginertia="0.0102675 0.0102675 0.00666"/>
        <joint name="shoulder_pan_joint" class="size3" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue" class="ur5e_vis"/>
        <geom mesh="shoulder_1" material="black" class="ur5e_vis"/>
        <geom mesh="shoulder_2" material="jointgray" class="ur5e_vis"/>
        <geom class="ur5e_col" size="0.06 0.06" pos="0 0 -0.04"/>

        <body name="upper_arm_link" pos="0 0.138 0" quat="1 0 1 0">
          <inertial mass="8.393" pos="0 0 0.2125"
                    diaginertia="0.133886 0.133886 0.0151074"/>
          <joint name="shoulder_lift_joint" class="size3"/>
          <geom mesh="upperarm_0" material="linkgray" class="ur5e_vis"/>
          <geom mesh="upperarm_1" material="black" class="ur5e_vis"/>
          <geom mesh="upperarm_2" material="jointgray" class="ur5e_vis"/>
          <geom mesh="upperarm_3" material="urblue" class="ur5e_vis"/>
          <geom class="ur5e_col" pos="0 -0.04 0" quat="1 1 0 0"
                size="0.06 0.06"/>
          <geom class="ur5e_col" size="0.05 0.2" pos="0 0 0.2"/>

          <body name="forearm_link" pos="0 -0.131 0.425">
            <inertial mass="2.275" pos="0 0 0.196"
                      diaginertia="0.0311796 0.0311796 0.004095"/>
            <joint name="elbow_joint" class="size3_limited"/>
            <geom mesh="forearm_0" material="urblue" class="ur5e_vis"/>
            <geom mesh="forearm_1" material="linkgray" class="ur5e_vis"/>
            <geom mesh="forearm_2" material="black" class="ur5e_vis"/>
            <geom mesh="forearm_3" material="jointgray" class="ur5e_vis"/>
            <geom class="ur5e_col" pos="0 0.08 0" quat="1 1 0 0"
                  size="0.055 0.06"/>
            <geom class="ur5e_col" size="0.038 0.19" pos="0 0 0.2"/>

            <body name="wrist_1_link" pos="0 0 0.392" quat="1 0 1 0">
              <inertial mass="1.219" pos="0 0.127 0"
                        diaginertia="0.0025599 0.0025599 0.0021942"/>
              <joint name="wrist_1_joint" class="size1"/>
              <geom mesh="wrist1_0" material="black" class="ur5e_vis"/>
              <geom mesh="wrist1_1" material="urblue" class="ur5e_vis"/>
              <geom mesh="wrist1_2" material="jointgray" class="ur5e_vis"/>
              <geom class="ur5e_col" pos="0 0.05 0" quat="1 1 0 0"
                    size="0.04 0.07"/>

              <body name="wrist_2_link" pos="0 0.127 0">
                <inertial mass="1.219" pos="0 0 0.1"
                          diaginertia="0.0025599 0.0025599 0.0021942"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size1"/>
                <geom mesh="wrist2_0" material="black" class="ur5e_vis"/>
                <geom mesh="wrist2_1" material="urblue" class="ur5e_vis"/>
                <geom mesh="wrist2_2" material="jointgray" class="ur5e_vis"/>
                <geom class="ur5e_col" size="0.04 0.06" pos="0 0 0.04"/>
                <geom class="ur5e_col" pos="0 0.02 0.1" quat="1 1 0 0"
                      size="0.04 0.04"/>

                <body name="wrist_3_link" pos="0 0 0.1">
                  <inertial mass="0.1889" pos="0 0.0771683 0" quat="1 0 0 1"
                            diaginertia="0.000132134 9.90863e-05 9.90863e-05"/>
                  <joint name="wrist_3_joint" class="size1"/>
                  <geom material="linkgray" mesh="wrist3" class="ur5e_vis"/>
                  <geom class="eef_collision" pos="0 0.08 0" quat="1 1 0 0"
                        size="0.04 0.02"/>
                  <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>

                  <!-- =========== ROBOTIQ 2F-85 GRIPPER =========== -->
                  <body name="gripper_attach" pos="0 0.1 0" quat="-1 1 0 0">
                    <body name="base_mount" pos="0 0 0.007" childclass="2f85">
                      <geom class="grip_vis" mesh="base_mount"
                            material="grip_black"/>
                      <geom class="grip_col" mesh="base_mount"/>

                      <body name="gripper_base" pos="0 0 0.0038" quat="1 0 0 -1">
                        <inertial mass="0.777441" pos="0 -2.70394e-05 0.0354675"
                                  quat="1 -0.00152849 0 0"
                                  diaginertia="0.000260285 0.000225381 0.000152708"/>
                        <geom class="grip_vis" mesh="base" material="grip_black"/>
                        <geom class="grip_col" mesh="base"/>
                        <site name="pinch" pos="0 0 0.145" type="sphere"
                              group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>

                        <!-- Right 4-bar linkage -->
                        <body name="right_driver" pos="0 0.0306011 0.054904">
                          <inertial mass="0.00899563"
                                    pos="2.96931e-12 0.0177547 0.00107314"
                                    quat="0.681301 0.732003 0 0"
                                    diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                          <joint name="right_driver_joint" class="driver"/>
                          <geom class="grip_vis" mesh="driver" material="gray"/>
                          <geom class="grip_col" mesh="driver"/>
                          <body name="right_coupler" pos="0 0.0315 -0.0041">
                            <inertial mass="0.0140974"
                                      pos="0 0.00301209 0.0232175"
                                      quat="0.705636 -0.0455904 0.0455904 0.705636"
                                      diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                            <joint name="right_coupler_joint" class="coupler"/>
                            <geom class="grip_vis" mesh="coupler"
                                  material="grip_black"/>
                            <geom class="grip_col" mesh="coupler"/>
                          </body>
                        </body>
                        <body name="right_spring_link" pos="0 0.0132 0.0609">
                          <inertial mass="0.0221642"
                                    pos="-8.65005e-09 0.0181624 0.0212658"
                                    quat="0.663403 -0.244737 0.244737 0.663403"
                                    diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                          <joint name="right_spring_link_joint" class="spring_link"/>
                          <geom class="grip_vis" mesh="spring_link"
                                material="grip_black"/>
                          <geom class="grip_col" mesh="spring_link"/>
                          <body name="right_follower" pos="0 0.055 0.0375">
                            <inertial mass="0.0125222"
                                      pos="0 -0.011046 0.0124786"
                                      quat="1 0.1664 0 0"
                                      diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                            <joint name="right_follower_joint" class="follower"/>
                            <geom class="grip_vis" mesh="follower"
                                  material="grip_black"/>
                            <geom class="grip_col" mesh="follower"/>
                            <body name="right_pad" pos="0 -0.0189 0.01352">
                              <geom class="pad_box1" name="right_pad1"/>
                              <geom class="pad_box2" name="right_pad2"/>
                              <inertial mass="0.0035" pos="0 -0.0025 0.0185"
                                        quat="0.707107 0 0 0.707107"
                                        diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                              <geom class="grip_vis" mesh="pad"/>
                              <body name="right_silicone_pad">
                                <geom class="grip_vis" mesh="silicone_pad"
                                      material="grip_black"/>
                              </body>
                            </body>
                          </body>
                        </body>

                        <!-- Left 4-bar linkage -->
                        <body name="left_driver" pos="0 -0.0306011 0.054904"
                              quat="0 0 0 1">
                          <inertial mass="0.00899563"
                                    pos="0 0.0177547 0.00107314"
                                    quat="0.681301 0.732003 0 0"
                                    diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                          <joint name="left_driver_joint" class="driver"/>
                          <geom class="grip_vis" mesh="driver" material="gray"/>
                          <geom class="grip_col" mesh="driver"/>
                          <body name="left_coupler" pos="0 0.0315 -0.0041">
                            <inertial mass="0.0140974"
                                      pos="0 0.00301209 0.0232175"
                                      quat="0.705636 -0.0455904 0.0455904 0.705636"
                                      diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                            <joint name="left_coupler_joint" class="coupler"/>
                            <geom class="grip_vis" mesh="coupler"
                                  material="grip_black"/>
                            <geom class="grip_col" mesh="coupler"/>
                          </body>
                        </body>
                        <body name="left_spring_link" pos="0 -0.0132 0.0609"
                              quat="0 0 0 1">
                          <inertial mass="0.0221642"
                                    pos="-8.65005e-09 0.0181624 0.0212658"
                                    quat="0.663403 -0.244737 0.244737 0.663403"
                                    diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                          <joint name="left_spring_link_joint" class="spring_link"/>
                          <geom class="grip_vis" mesh="spring_link"
                                material="grip_black"/>
                          <geom class="grip_col" mesh="spring_link"/>
                          <body name="left_follower" pos="0 0.055 0.0375">
                            <inertial mass="0.0125222"
                                      pos="0 -0.011046 0.0124786"
                                      quat="1 0.1664 0 0"
                                      diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                            <joint name="left_follower_joint" class="follower"/>
                            <geom class="grip_vis" mesh="follower"
                                  material="grip_black"/>
                            <geom class="grip_col" mesh="follower"/>
                            <body name="left_pad" pos="0 -0.0189 0.01352">
                              <geom class="pad_box1" name="left_pad1"/>
                              <geom class="pad_box2" name="left_pad2"/>
                              <inertial mass="0.0035" pos="0 -0.0025 0.0185"
                                        quat="1 0 0 1"
                                        diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                              <geom class="grip_vis" mesh="pad"/>
                              <body name="left_silicone_pad">
                                <geom class="grip_vis" mesh="silicone_pad"
                                      material="grip_black"/>
                              </body>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ================= TARGET BOX (mocap, kinematic) ================= -->
    <!-- Open-top tray. Inner footprint 0.12 m x 0.12 m, walls 0.05 m tall.
         Pose is set each reset via data.mocap_pos. Body origin sits on the
         floor (z = 0); geoms are placed relative to that origin. -->
    <body name="target_box" mocap="true" pos="0.45 0.15 0.0">
      <site name="box_center" pos="0 0 0.025" size="0.005"
            rgba="1 0.6 0.1 1" group="4"/>
      <geom name="box_floor" type="box"  pos="0 0 0.0025"
            size="0.068 0.068 0.0025"  rgba="0.78 0.55 0.27 1"
            friction="0.8 0.005 0.0001"/>
      <geom name="box_wall_n" type="box" pos="0 0.064 0.0275"
            size="0.068 0.004 0.025"   rgba="0.78 0.55 0.27 1"/>
      <geom name="box_wall_s" type="box" pos="0 -0.064 0.0275"
            size="0.068 0.004 0.025"   rgba="0.78 0.55 0.27 1"/>
      <geom name="box_wall_e" type="box" pos="0.064 0 0.0275"
            size="0.004 0.060 0.025"   rgba="0.78 0.55 0.27 1"/>
      <geom name="box_wall_w" type="box" pos="-0.064 0 0.0275"
            size="0.004 0.060 0.025"   rgba="0.78 0.55 0.27 1"/>
    </body>

    <!-- ================= CUBE (free body, the object to pick up) ============ -->
    <!-- 3 cm cube. Free joint so gravity drops it onto the floor and the
         gripper can lift / move it. Initial pose is set each reset. -->
    <body name="cube" pos="0.45 -0.15 0.02">
      <freejoint name="cube_free"/>
      <inertial mass="1.0" pos="0 0 0"
                diaginertia="1.5e-4 1.5e-4 1.5e-4"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015"
            rgba="0.15 0.55 0.95 1"
            friction="1.2 0.01 0.001"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"/>
      <site name="cube_center" pos="0 0 0" size="0.003"
            rgba="1 1 0 1" group="4"/>
    </body>
  </worldbody>

  <contact>
    <!-- From 2F-85 original -->
    <exclude body1="gripper_base" body2="left_driver"/>
    <exclude body1="gripper_base" body2="right_driver"/>
    <exclude body1="gripper_base" body2="left_spring_link"/>
    <exclude body1="gripper_base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler"
             solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler"
             solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint"
           polycoef="0 1 0 0 0"
           solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <actuator>
    <!-- UR5e arm -->
    <general class="size3"         name="shoulder_pan"  joint="shoulder_pan_joint"/>
    <general class="size3"         name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size3_limited" name="elbow"         joint="elbow_joint"/>
    <general class="size1"         name="wrist_1"       joint="wrist_1_joint"/>
    <general class="size1"         name="wrist_2"       joint="wrist_2_joint"/>
    <general class="size1"         name="wrist_3"       joint="wrist_3_joint"/>
    <!-- Robotiq 2F-85 (ctrlrange: 0=open, 255=closed) -->
    <general class="2f85" name="fingers_actuator" tendon="split"
             forcerange="-5 5" ctrlrange="0 255"
             gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>
